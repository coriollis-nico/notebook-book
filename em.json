mn":1},"end":{"line":1,"column":1}},"key":"gAFjjRWA0T"},{"type":"inlineMath","value":"j","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>j</mi></mrow><annotation encoding=\"application/x-tex\">j</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.854em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.05724em;\">j</span></span></span></span>","key":"CKOyC9MjFt"},{"type":"text","value":"-ésima partícula en su\n","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"J7PYMcMX3z"},{"type":"inlineMath","value":"(j-1)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo stretchy=\"false\">(</mo><mi>j</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">(j-1)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mopen\">(</span><span class=\"mord mathnormal\" style=\"margin-right:0.05724em;\">j</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">1</span><span class=\"mclose\">)</span></span></span></span>","key":"UdR1fvwz72"},{"type":"text","value":"-ésima posición (recordemos que los índices en Python empiezan en 0).\nLuego haremos lo mismo para las cargas. Las cargas son cantidades escalares, por lo que\ntendremos un arreglo de ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xmQyoNFx7A"},{"type":"inlineCode","value":"float","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HMX7DKEVTe"},{"type":"text","value":"s.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Sk5bWhJfeK"}],"key":"ycpf51tPxF"}],"key":"gKGh30ny94"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"positions: list[list[float]] = [\n    [\n        7.0 * math.cos(2.0 * math.pi * i / 5),\n        7.0 * math.sin(2.0 * math.pi * i / 5),\n        (j - 4),\n    ]\n    for i in range(1, 6)\n    for j in range(1, 8)\n]\n# nota que usamos posiciones en metros\n\ncharges: list[float] = [(i - j) * 1.0e-6 for i in range(1, 6) for j in range(1, 8)]","key":"VHuXfTBxs3"},{"type":"outputs","id":"40emCOzrNLX8Q8UVkJ0W9","children":[],"key":"Io16rKHFtt"}],"key":"k1m7M4opl9"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Ahora implementemos una función que toma una lista de coordenadas y una lista de cargas\ny calcula el campo eléctrico en una posición dada.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"snfp8dzy69"}],"key":"WJA9QDSx5c"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"En una aplicación tal vez sería más conveniente implementar partículas cargadas como\nobjetos, pero esto es demasiado complejo para este problema específico.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"yMAPZijdMK"}],"key":"CWGziy7NZn"}],"key":"v2gxqRaTQh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def efield_points(\n    r: list[float], rs: list[list[float]], qs: list[float]\n) -> list[float]:\n    \"\"\"\n    Dada una lista de posiciones rs [m] y de cargas qs [C] para cada posición, calcula el\n    campo eléctrico [N/C] en r [m].\n    \"\"\"\n\n    if len(rs) != len(qs):\n        raise ValueError(\"rs y qs no son de la misma dimensión\")\n\n    if any([len(ri) != 3 for ri in rs]):\n        raise TypeError(\"Todas las posiciones deben ser vectores 3D.\")\n\n    epsilon_0 = 8.854e-12  # C^2 / N / m^2\n\n    E = [\n        (1.0 / 4.0 / math.pi / epsilon_0)\n        * sum(\n            qs[i]\n            * (r[k] - rs[i][k])\n            / (sum((r[m] - rs[i][m]) ** 2.0 for m in range(3))) ** 1.5\n            for i in range(len(rs))\n        )\n        for k in range(3)\n    ]\n\n    return E","key":"Uf5UgpXbyr"},{"type":"outputs","id":"3piyKUYUL7xJRtQ4_pDDS","children":[],"key":"vp67QPFy02"}],"key":"iOgCg9sk2p"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Este es un código un poco difícil de leer. Como Python no incluye vectores, debemos ser\nespecíficos con los índices de nuestras listas.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZkLrrVfZxK"}],"key":"uC0w77yZbT"}],"key":"crbEjf6kxg"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"La función ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"aMGbds8yP7"},{"type":"inlineCode","value":"efield_points","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"a9hT2n9Hoq"},{"type":"text","value":" nos da un “vector” cartesiano para el campo eléctrico.\nTal vez sea más conveniente convertir a coordenadas esféricas.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B25h2AYkO3"}],"key":"jk0fEr8rv8"}],"key":"NrdBY4ZiGV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def spherical(x: float, y: float, z: float) -> list[float]:\n    \"\"\"\n    Convierte coordenadas cartesianas a las coordenadas [r, theta, phi] correspondientes.\n    \"\"\"\n\n    r = math.hypot(x, y, z)\n\n    theta = math.acos(z / r)\n\n    phi = math.atan2(y, x)\n\n    return [r, theta, phi]","key":"HZFcFch1UC"},{"type":"outputs","id":"t_mkbgzqCQaPNzHsL9md4","children":[],"key":"F6m3C4wMHi"}],"key":"CnMBGDIzqR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"E0 = efield_points([0.0, 0.0, 0.0], positions, charges)\nr0, theta0, phi0 = spherical(E0[0], E0[1], E0[2])\n\nprint(\n    f\"En el origen el campo es E = {r0:.2e} N/C\",\n    f\"con ángulo θ = {math.degrees(theta0):.1f}°\",\n    f\"y φ = {math.degrees(phi0):.1f}°.\",\n)","key":"uAcVAZz7Fc"},{"type":"outputs","id":"RdwYWb71JNqVYlgssXIMY","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"En el origen el campo es E = 5.75e+03 N/C con ángulo θ = 58.3° y φ = 126.0°.\n"},"key":"ysr13BPPYv"}],"key":"mtEqKGUuWn"}],"key":"yJfvZj6vap"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"Efar = efield_points([5.0, 7.6, 5.67], positions, charges)\nr_far, theta_far, phi_far = spherical(Efar[0], Efar[1], Efar[2])\n\nprint(\n    f\"En el punto lejano el campo es E = {r_far:.2e} N/C\",\n    f\"con ángulo θ = {math.degrees(theta_far):.1f}°\",\n    f\"y φ = {math.degrees(phi_far):.1f}°.\",\n)","key":"jpzFSh9TXf"},{"type":"outputs","id":"XqaTPnguxoEkBeH4Q2rRh","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"En el punto lejano el campo es E = 8.25e+03 N/C con ángulo θ = 133.5° y φ = -161.7°.\n"},"key":"m2dIRkho0A"}],"key":"qWSfsD94w9"}],"key":"aTvHLWUnkp"}],"key":"cvlaCKYnE0"},"references":{"cite":{"order":["Purcell2013"],"data":{"Purcell2013":{"label":"Purcell2013","enumerator":"1","html":"Purcell, E. M., & Morin, D. J. (2013). <i>Electricity and Magnetism</i> (3rd ed.). Cambridge University Press."}}}},"footer":{"navigation":{"prev":{"title":"Ejemplo: termodinámica","url":"/thermo","group":"Física en Cuadernos Computacionales"},"next":{"title":"Péndulo simple I","url":"/pendulum-pt1","group":"Física en Cuadernos Computacionales"}}},"domain":"http://localhost:3000"}